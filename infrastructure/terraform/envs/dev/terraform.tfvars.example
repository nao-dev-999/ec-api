# プロジェクト基本情報
project     = "ec-api-test"
env         = "dev"
aws_region  = "ap-northeast-1"

# ネットワーク設定
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
availability_zones   = ["ap-northeast-1a", "ap-northeast-1c"]

# RDS設定
rds_engine          = "postgres"
rds_engine_version  = "18.4"
rds_instance_class  = "db.t3.micro"
rds_database_name   = "awstest"
rds_master_username = "awstest"

# CodePipeline / GitHub
github_repository       = "your-org/ec-api"
github_branch           = "main"

# AWS Config
config_notification_emails = ["you@example.com"]

# CloudWatch Alarms
alarm_notification_emails = ["you@example.com"]

# AWS Budgets
monthly_budget_usd         = "50"
budget_notification_emails = ["you@example.com"]

# Swagger UI（デフォルトは非公開。動作確認等で一時的に公開したい場合のみtrueにする）
swagger_enabled = false

# CodePipeline（本番相当環境ではtrueにしてDeploy前に手動承認を挟むことを推奨）
manual_approval_enabled = false
